<mxCell id="e24" edge="1" parent="1" source="VIPCustomer" target="Customer" style="rounded=0;html=1;endArrow=block;endFill=0;endSize=14;exitX=0.6765;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.3333;entryY=1.0000;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="e25" edge="1" parent="1" source="CriticCustomer" target="Customer" style="rounded=0;html=1;endArrow=block;endFill=0;endSize=14;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.8810;entryY=1.0000;entryDx=0;entryDy=0;" value=""><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="1770"/><mxPoint x="930" y="1770"/></Array></mxGeometry></mxCell>
<mxCell id="n1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" value="&lt;b&gt;Encapsulation&lt;/b&gt;&lt;br&gt;Fields are private and have no setters. A Customer or an Order changes state only through event methods that check the current state first (requireState / requireStatus)." vertex="1"><mxGeometry x="40" y="820" width="560" height="90" as="geometry"/></mxCell>
<mxCell id="n2" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" value="&lt;b&gt;Dependency inversion&lt;/b&gt;&lt;br&gt;GameController depends on the GameView interface (not ConsoleUI) and only on the abstract Customer: the arrival list decides the types, so no customer class is named in the controller." vertex="1"><mxGeometry x="40" y="100" width="560" height="110" as="geometry"/></mxCell>
<mxCell id="n3" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" value="&lt;b&gt;Composition&lt;/b&gt;&lt;br&gt;GameController creates and owns the staff and the statistics. Menu owns its MenuItems." vertex="1"><mxGeometry x="1560" y="40" width="420" height="80" as="geometry"/></mxCell>
<mxCell id="n5" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" value="&lt;b&gt;Polymorphism, template method, Liskov&lt;/b&gt;&lt;br&gt;The customer types only override the hooks satisfactionLossPerTurn(), getDiscountPercent() and pickDish(). The event methods are final {leaf}, so every type follows the same visit (checked by CustomerSubstitutionTest). The Critic always orders the most expensive dish." vertex="1"><mxGeometry x="100" y="2010" width="760" height="100" as="geometry"/></mxCell>
<mxCell id="n4" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;" value="&lt;b&gt;Not drawn&lt;/b&gt;&lt;br&gt;The records TurnSnapshot, GameResult and ActionResult, private helper methods, and the lists GameController keeps (shown as its attributes)." vertex="1"><mxGeometry x="1270" y="1900" width="400" height="105" as="geometry"/></mxCell>
<mxCell id="legend" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=11;fillColor=#ffffff;strokeColor=#666666;" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;solid arrow: stored field (association)&lt;br&gt;filled diamond: composition (owner creates the part)&lt;br&gt;dashed arrow: uses (parameter / return / local)&lt;br&gt;solid, hollow triangle: inherits (extends)&lt;br&gt;dashed, hollow triangle: implements&lt;br&gt;italics: abstract. {leaf}: final" vertex="1"><mxGeometry x="2030" y="40" width="440" height="150" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>