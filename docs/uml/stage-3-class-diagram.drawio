                <mxCell id="e34_l1" parent="e34" value="2" vertex="1" connectable="0" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;">
                    <mxGeometry x="0.250" relative="1" as="geometry">
