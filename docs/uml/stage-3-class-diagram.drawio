                <mxCell id="e35" parent="1" style="rounded=0;html=1;dashed=1;endArrow=open;endSize=12;exitX=1.0000;exitY=0.7353;exitDx=0;exitDy=0;entryX=0.0000;entryY=1.6304;entryDx=0;entryDy=0;" value="" edge="1" source="MenuItem" target="Money">
